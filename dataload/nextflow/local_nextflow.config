process.container = System.getenv('OLS4_DATALOAD_IMAGE')
docker.enabled = true
// Ensure tasks run with the host UID:GID to avoid permission issues in mounted work dirs
docker.runOptions = "-u ${System.getenv('HOST_UID')}:${System.getenv('HOST_GID')} -v ${System.getenv('OLS_HOME')}:${System.getenv('OLS_HOME')} -v ${System.getenv('OLS_EMBEDDINGS_PATH')}:${System.getenv('OLS_EMBEDDINGS_PATH')} -e OPENAI_API_KEY"

params.embed_image = System.getenv('OLS4_EMBED_IMAGE') ?: ''

params.solr_mem = "16g"
params.neo_mem = "16g"
params.enable_embeddings = false

// Use local config files instead of fetching from NFS (CI / local dev)
params.config_files = System.getenv('OLS4_CONFIG') ?: ''

executor {
    queueSize = 1
}

process {
    withName: rdf2json {
        memory = 64.GB
    }
}

process {
    withName: linker__create_manifest {
        memory = 64.GB
        cpus = 1
    }
}

process {
    withName: linker__link_ontologies {
        memory = 64.GB
    }
}

process {
    withName: json2neo {
        memory = 64.GB
    }
}

process {
    withName: json2solr {
        memory = 64.GB
    }
}

process {
    withName: create_neo {
        memory = 64.GB
        cpus = 1
    }
}

process {
    withName: create_solr {
        memory = 64.GB
        cpus = 1
    }
}

process {
    withName: extract_strings_from_terms {
        memory = 12.GB
        cpus = 1
    }
}

process {
    withName: build_text_tagger_db {
        memory = 12.GB
        cpus = 1
    }
}

process {
    withName: extract_sssom {
        memory = 12.GB
    }
}
